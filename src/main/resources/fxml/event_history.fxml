<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.seismic.controller.EventHistoryController" spacing="10" styleClass="page">
    <HBox spacing="8" alignment="CENTER_LEFT">
        <Label text="Event History" styleClass="page-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Status"/>
        <ComboBox fx:id="statusFilter"/>
        <Label text="Source"/>
        <ComboBox fx:id="sourceFilter"/>
        <Button text="Reload from storage" onAction="#onReload"/>
    </HBox>
    <Label fx:id="storageLabel" styleClass="hint"/>
    <SplitPane orientation="VERTICAL" dividerPositions="0.45" VBox.vgrow="ALWAYS">
        <TableView fx:id="eventsTable"/>
        <HBox spacing="10">
            <VBox styleClass="card" spacing="6" prefWidth="340" minWidth="300">
                <Label fx:id="detailTitle" text="No event selected" styleClass="card-title" wrapText="true"/>
                <Label fx:id="confidenceLabel" wrapText="true" styleClass="latest-event"/>
                <Label fx:id="agreementLabel"/>
                <Label fx:id="temporalLabel"/>
                <Label fx:id="spatialLabel"/>
                <Label fx:id="signalLabel"/>
                <Label wrapText="true" styleClass="hint"
                       text="n/a = factor could not be evaluated (e.g. missing coordinates) and was left out of the weighted average."/>
            </VBox>
            <TabPane HBox.hgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE">
                <Tab text="Decision explanation">
                    <ListView fx:id="explanationList"/>
                </Tab>
                <Tab text="Participating sensors">
                    <TableView fx:id="participantsTable"/>
                </Tab>
                <Tab text="Contributing readings">
                    <VBox spacing="4" styleClass="tab-body">
                        <Label fx:id="readingsLabel"/>
                        <TableView fx:id="readingsTable" VBox.vgrow="ALWAYS"/>
                    </VBox>
                </Tab>
            </TabPane>
        </HBox>
    </SplitPane>
</VBox>

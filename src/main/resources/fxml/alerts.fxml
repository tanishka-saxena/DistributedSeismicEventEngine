<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.seismic.controller.AlertsController" spacing="10" styleClass="page">
    <HBox spacing="8" alignment="CENTER_LEFT">
        <Label text="Alerts" styleClass="page-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <CheckBox fx:id="unacknowledgedOnly" text="Unacknowledged only"/>
        <Button text="Acknowledge selected" onAction="#onAcknowledgeSelected" styleClass="btn-primary"/>
        <Button text="Acknowledge all" onAction="#onAcknowledgeAll"/>
    </HBox>
    <Label fx:id="mostUrgentLabel" styleClass="most-urgent" wrapText="true" maxWidth="Infinity"/>
    <TableView fx:id="alertsTable" VBox.vgrow="ALWAYS"/>
</VBox>
